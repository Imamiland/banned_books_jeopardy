# Database
# Local SQLite (default for development)
DATABASE_URL="file:local.db"
# Remote Turso (optional, for production)
# DATABASE_URL="libsql://db-name-user.turso.io"
# DATABASE_AUTH_TOKEN=""

# Auth0 (mocked locally by default)
AUTH0_DOMAIN="dev.example.auth0.com"
AUTH0_CLIENT_ID="mock-client-id"
AUTH0_CLIENT_SECRET="mock-client-secret" # pragma: allowlist secret
AUTH0_CALLBACK_URL="http://localhost:5173/auth/callback"
AUTH0_LOGOUT_URL="http://localhost:5173"
AUTH0_AUDIENCE="https://your-api-audience"
AUTH0_SCOPE="openid profile email"

# Application
PUBLIC_APP_URL="http://localhost:5173"
SECRET_SESSION_KEY="dev-secret-change-me" # pragma: allowlist secret

# Vercel (auto-provided on deployment)
# VERCEL_URL="auto-provided-by-vercel"
# VERCEL_ENV="production"
