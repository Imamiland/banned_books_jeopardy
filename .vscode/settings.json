{
  // === Runtime Configuration ===
  "debug.javascript.defaultRuntimeExecutable": {
    "pwa-node": "/Users/aimami/.local/share/mise/shims/node"
  },
  "python.defaultInterpreterPath": "/Users/aimami/.local/share/mise/installs/python/3.12.10/bin/python",
  "java.jdt.ls.java.home": "/Users/aimami/.local/share/mise/installs/java/temurin-21.0.4+7.0.LTS",
  "java.import.gradle.java.home": "/Users/aimami/.local/share/mise/installs/java/temurin-21.0.4+7.0.LTS",

  // === SonarLint Configuration ===
  "sonarlint.connectedMode.project": {
    "connectionId": "imamiland",
    "projectKey": "Imamiland_banned_books_jeopardy"
  },

  // === Editor Configuration ===
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [
    100,
    120
  ],
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",

  // === Svelte Configuration ===
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
    "editor.tabSize": 4
  },
  "svelte.enable-ts-plugin": true,
  "svelte.plugin.svelte.compilerWarnings": {
    "a11y-accesskey": "ignore",
    "a11y-aria-attributes": "error",
    "a11y-click-events-have-key-events": "error",
    "a11y-incorrect-aria-attribute-type": "error",
    "a11y-invalid-attribute": "error",
    "a11y-missing-attribute": "error",
    "a11y-missing-content": "error",
    "a11y-no-abstract-role": "error",
    "a11y-no-interactive-element-to-noninteractive-role": "error",
    "a11y-no-noninteractive-element-interactions": "error",
    "a11y-no-noninteractive-element-to-interactive-role": "error",
    "a11y-no-noninteractive-tabindex": "error",
    "a11y-no-redundant-roles": "error",
    "a11y-no-static-element-interactions": "error",
    "a11y-positive-tabindex": "error",
    "a11y-role-has-required-aria-props": "error",
    "a11y-unknown-aria-attribute": "error",
    "a11y-unknown-role": "error"
  },

  // === TypeScript Configuration ===
  // Note: The following formatter settings require the Prettier extension.
  // Install recommended extensions to resolve validation warnings.
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "javascript.preferences.importModuleSpecifier": "non-relative",

  // === JSON & YAML Configuration ===
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 4
  },

  // === Markdown Configuration ===
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "on",
      "strings": "on",
      "other": "on"
    }
  },
  "markdown.validate.enabled": true,

  // === Prettier Configuration ===
  // These settings require esbenp.prettier-vscode extension (see extensions.json)
  "prettier.configPath": ".prettierrc",
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": false,

  // === ESLint Configuration ===
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "svelte"
  ],
  "eslint.useFlatConfig": true,

  // === Tailwind CSS Configuration ===
  "tailwindCSS.experimental.classRegex": [
    [
      "class:([\\w-]+)",
      "([\\w-]+)"
    ],
    [
      "(?:enter|leave)(?:From|To)?=\\s*(?:\"|')([^(?:\"|')]*)",
      "([^\\s]*)"
    ]
  ],
  "tailwindCSS.includeLanguages": {
    "svelte": "html"
  },
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.svelte-kit/**",
    "**/build/**",
    "**/dist/**"
  ],

  // === File Associations ===
  "files.associations": {
    "*.css": "tailwindcss",
    ".env*": "dotenv"
  },

  // === Exclusions ===
  "files.exclude": {
    "**/.git": true,
    "**/.svelte-kit": true,
    "**/node_modules": true,
    "**/.DS_Store": true,
    "**/dist": true,
    "**/build": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.svelte-kit": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.vercel": true,
    "**/coverage": true,
    "**/pnpm-lock.yaml": true,
    "**/package-lock.json": true
  },

  // === Git Configuration ===
  "git.ignoreLimitWarning": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,

  // === Terminal Configuration ===
  "terminal.integrated.env.osx": {
    "MISE_SHELL": "zsh"
  },
  "terminal.integrated.defaultProfile.osx": "zsh",

  // === Testing Configuration ===
  "playwright.reuseBrowser": true,
  "playwright.showTrace": "on-failure",

  // === Error Lens Configuration ===
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning"
  ],
  "errorLens.excludeBySource": [
    "cSpell"
  ],

  // === TODO Tree Configuration ===
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "NOTE",
    "HACK",
    "XXX",
    "BUG"
  ],
  "todo-tree.highlights.defaultHighlight": {
    "icon": "alert",
    "type": "text",
    "foreground": "#fff",
    "opacity": 50
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "foreground": "#1e90ff"
    },
    "FIXME": {
      "icon": "alert",
      "foreground": "#ff6347"
    },
    "BUG": {
      "icon": "bug",
      "foreground": "#dc143c"
    }
  },

  // === Spell Checker Configuration ===
  "cSpell.enabled": true,
  "cSpell.diagnosticLevel": "Hint",

  // === GitLens Configuration ===
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",

  // === Drizzle Configuration ===
  "drizzle.configPath": "drizzle.config.ts"
}
